{
  "opencollection": "1.0.0",
  "info": {
    "name": "Justworks Company Deduction Types API",
    "version": "2026-05-25"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://secure.justworks.com/oauth/authorize",
